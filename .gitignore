!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/processed/README.md
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# System files
.DS_Store
Thumbs.db

# Credentials or local configuration
*.key
*.pem
.env
